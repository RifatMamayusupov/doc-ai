# Database
DATABASE_URL=sqlite+aiosqlite:///./docagent.db
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DeepAgents
DEEPAGENTS_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# Extra Tools (dynamic code storage)
EXTRA_TOOLS_DIR=./extra_tools
